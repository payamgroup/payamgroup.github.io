
---
// Subtle site-wide interactions for Payam Research Group.
// Keeps the existing BaseLayout scroll-reveal animations.
---

<div class="reading-progress" aria-hidden="true">
  <span
    class="reading-progress-bar"
    data-reading-progress
  ></span>
</div>

<script>
  let motionObserver: IntersectionObserver | null = null;

  let removeScrollListeners:
    (() => void) | null = null;

  function initialisePageInteractions() {

    // Clean up listeners from the previous page.
    // Important when using Astro ClientRouter.

    motionObserver?.disconnect();
    motionObserver = null;

    removeScrollListeners?.();
    removeScrollListeners = null;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)"
    ).matches;

    // Animate only text that is not already
    // controlled by BaseLayout's data-reveal system.

    const textElements =
      document.querySelectorAll<HTMLElement>(
        [
          ".hero .eyebrow",
          ".hero .hero-eyebrow",
          ".hero h1",
          ".hero .hero-description",
          ".section-heading h2",
          ".section-heading .section-description"
        ].join(", ")
      );

    if (
      !reduceMotion &&
      "IntersectionObserver" in window
    ) {

      motionObserver = new IntersectionObserver(
        (entries, observer) => {

          for (const entry of entries) {

            if (entry.isIntersecting) {

              entry.target.classList.add(
                "payam-motion-visible"
              );

              observer.unobserve(entry.target);

            }

          }

        },
        {
          threshold: 0.12,
          rootMargin: "0px 0px -24px 0px"
        }
      );

      for (const element of textElements) {

        if (element.closest("[data-reveal]")) {
          continue;
        }

        element.classList.add(
          "payam-motion-ready"
        );

        motionObserver.observe(element);

      }

    }

    // Reading-progress indicator.

    const progress =
      document.querySelector<HTMLElement>(
        "[data-reading-progress]"
      );

    if (!progress) return;

    let frameRequested = false;

    const updateProgress = () => {

      frameRequested = false;

      const scrollable = Math.max(
        document.documentElement.scrollHeight -
          window.innerHeight,
        0
      );

      const amount = scrollable > 0
        ? Math.min(
            Math.max(
              window.scrollY / scrollable,
              0
            ),
            1
          )
        : 0;

      progress.style.transform =
        `scaleX(${amount})`;

    };

    const onScroll = () => {

      if (frameRequested) return;

      frameRequested = true;

      window.requestAnimationFrame(
        updateProgress
      );

    };

    window.addEventListener(
      "scroll",
      onScroll,
      { passive: true }
    );

    window.addEventListener(
      "resize",
      onScroll
    );

    removeScrollListeners = () => {

      window.removeEventListener(
        "scroll",
        onScroll
      );

      window.removeEventListener(
        "resize",
        onScroll
      );

    };

    updateProgress();

  }

  // Re-initialise after Astro page transitions.

  document.addEventListener(
    "astro:page-load",
    initialisePageInteractions
  );

  if (document.readyState === "loading") {

    document.addEventListener(
      "DOMContentLoaded",
      initialisePageInteractions,
      { once: true }
    );

  } else {

    initialisePageInteractions();

  }

  document.addEventListener(
    "astro:before-swap",
    () => {

      motionObserver?.disconnect();
      motionObserver = null;

      removeScrollListeners?.();
      removeScrollListeners = null;

    }
  );
</script>

<style>

  /* ===================================== */
  /* READING PROGRESS                     */
  /* ===================================== */

  .reading-progress {
    position: fixed;
    inset: 0 0 auto;

    height: 3px;
    z-index: 1100;

    pointer-events: none;
  }

  .reading-progress-bar {
    display: block;
    width: 100%;
    height: 100%;

    background: #117e88;

    transform: scaleX(0);
    transform-origin: left center;
  }


  /* ===================================== */
  /* SMOOTH SCROLLING                     */
  /* ===================================== */

  :global(html) {
    scroll-behavior: smooth;
  }


  /* ===================================== */
  /* ANIMATIONS                           */
  /* ===================================== */

  @media (prefers-reduced-motion: no-preference) {

    /* Gently reveal headings and text */

    :global(.payam-motion-ready) {
      opacity: 0;
      transform: translateY(18px);

      transition:
        opacity 700ms ease,
        transform 700ms cubic-bezier(
          0.22, 1, 0.36, 1
        );
    }

    :global(
      .payam-motion-ready.payam-motion-visible
    ) {
      opacity: 1;
      transform: translateY(0);
    }

    /* Slight stagger for hero headings */

    :global(.hero h1.payam-motion-ready) {
      transition-delay: 90ms;
    }

    :global(
      .hero .hero-description.payam-motion-ready
    ) {
      transition-delay: 170ms;
    }


    /* =================================== */
    /* BUTTON INTERACTIONS                 */
    /* =================================== */

    :global(.hero-button),
    :global(.button-outline-dark),
    :global(.button-light),
    :global(.section-navigation a) {

      transition:
        transform 220ms ease,
        box-shadow 220ms ease,
        background-color 220ms ease,
        border-color 220ms ease,
        color 220ms ease;

    }

    :global(.hero-button:hover),
    :global(.button-outline-dark:hover),
    :global(.button-light:hover),
    :global(.section-navigation a:hover) {

      transform: translateY(-2px);

      box-shadow:
        0 8px 20px rgba(17, 36, 58, 0.15);

    }

    :global(.hero-button:active),
    :global(.button-outline-dark:active),
    :global(.button-light:active),
    :global(.section-navigation a:active) {

      transform: translateY(0) scale(0.98);

    }


    /* =================================== */
    /* TEXT LINK INTERACTIONS              */
    /* =================================== */

    :global(.text-link),
    :global(.publication-link),
    :global(.profile-links a) {

      transition:
        color 180ms ease,
        text-decoration-color 180ms ease;

      text-decoration-thickness: 1px;
      text-underline-offset: 4px;

    }

    :global(.text-link:hover),
    :global(.publication-link:hover),
    :global(.profile-links a:hover) {

      text-decoration: underline;
      text-decoration-thickness: 2px;

    }

  }


  /* ===================================== */
  /* KEYBOARD ACCESSIBILITY              */
  /* ===================================== */

  :global(.hero-button:focus-visible),
  :global(.button-outline-dark:focus-visible),
  :global(.button-light:focus-visible),
  :global(.section-navigation a:focus-visible) {

    outline: 3px solid #8ae0dc;
    outline-offset: 4px;

  }


  /* ===================================== */
  /* REDUCED MOTION                       */
  /* ===================================== */

  @media (prefers-reduced-motion: reduce) {

    :global(html) {
      scroll-behavior: auto;
    }

    :global(.payam-motion-ready) {
      opacity: 1;
      transform: none;
      transition: none;
    }

  }

</style>
