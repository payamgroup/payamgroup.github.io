
---
import BaseLayout from "../layouts/BaseLayout.astro";
import { researchThemes } from "../data/researchThemes.js";
---

<BaseLayout
  title="Research"
  description="Explore the four SCMS research themes: computational and multiscale mechanics, architected materials and metamaterials, bio-inspired structures, and structural mechanics."
>
  <main>

    <!-- PAGE INTRODUCTION -->

    <section class="hero">
      <div class="container">
        <p class="eyebrow">PAYAM RESEARCH GROUP</p>

        <h1>Our Research</h1>

        <p class="hero-description">
          Connecting scientific computing, material
          modelling and structural mechanics to advance
          the understanding and design of materials
          and engineering structures.
        </p>
      </div>
    </section>

    <!-- CLICKABLE RESEARCH THEMES -->

    <section class="research-section">
      <div class="container">

        <div class="section-heading" data-reveal>
          <p class="section-label">RESEARCH THEMES</p>

          <h2>Explore Our Research</h2>

          <p class="section-description">
            Our research is organised into four
            complementary themes. Select an area
            to discover its research activities,
            projects and scientific contributions.
          </p>
        </div>

        <div class="research-grid" data-reveal>
          {researchThemes.map((theme) => (
            <a
              class="research-card"
              href={`/research/${theme.slug}/`}
            >
              <span class="number">
                {theme.number}
              </span>

              <h3>{theme.title}</h3>

              <p>{theme.description}</p>

              <span class="explore-link">
                Explore Research →
              </span>
            </a>
          ))}
        </div>

      </div>
    </section>

  </main>
</BaseLayout>

<style>
  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .hero {
    padding: 95px 8%;
    background: linear-gradient(
      120deg,
      #11243a,
      #285576
    );
    color: white;
  }

  .eyebrow {
    color: #8ae0dc;
    letter-spacing: 2px;
    font-size: 13px;
    font-weight: bold;
  }

  h1 {
    font-size: clamp(38px, 5vw, 64px);
    margin: 20px 0;
  }

  .hero-description {
    max-width: 750px;
    line-height: 1.8;
    font-size: 18px;
    color: #e0eaf2;
  }

  .research-section {
    padding: 85px 8%;
    background: #f7f9fc;
  }

  .section-heading {
    max-width: 850px;
    margin-bottom: 40px;
  }

  .section-label {
    color: #168b95;
    letter-spacing: 2px;
    font-size: 12px;
    font-weight: bold;
  }

  h2 {
    font-size: clamp(30px, 4vw, 42px);
    margin: 12px 0;
  }

  .section-description {
    color: #60758b;
    font-size: 17px;
    line-height: 1.8;
  }

  .research-grid {
    display: grid;
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
    gap: 25px;
  }

  .research-card {
    display: flex;
    flex-direction: column;
    padding: 38px;
    background: white;
    color: inherit;
    text-decoration: none;
    border: 1px solid #e1e8ef;
    border-radius: 12px;
  }

  .number {
    font-weight: bold;
    font-size: 14px;
    color: #168b95;
  }

  .research-card h3 {
    font-size: 23px;
    line-height: 1.4;
    margin: 25px 0 12px;
  }

  .research-card p {
    color: #60758b;
    line-height: 1.8;
    flex-grow: 1;
  }

  .explore-link {
    display: inline-block;
    margin-top: 20px;
    color: #168b95;
    font-weight: bold;
  }

  .research-card:focus-visible {
    outline: 3px solid #168b95;
    outline-offset: 4px;
  }

  @media (hover: hover) and
         (prefers-reduced-motion: no-preference) {
    .research-card {
      transition:
        transform 0.3s ease,
        box-shadow 0.3s ease;
    }

    .research-card:hover {
      transform: translateY(-6px);
      box-shadow: 0 15px 35px #00000018;
    }
  }

  @media (max-width: 700px) {
    .research-grid {
      grid-template-columns: 1fr;
    }

    .hero,
    .research-section {
      padding: 65px 7%;
    }

    .research-card {
      padding: 28px;
    }

    .hero-description {
      font-size: 16px;
    }
  }
</style>
